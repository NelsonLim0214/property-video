Dialogue: 2,0:00:00.00,0:00:56.67,Title,,0,0,0,,Semi-D 2 Tingkat · Malay Reserve
Dialogue: 2,0:00:00.00,0:00:56.67,Loc,,0,0,0,,Lokasi: Bandar Rimbayu, Selangor
Dialogue: 1,0:00:00.00,0:00:03.05,Sub,,0,0,0,,Rumah ini lebar 40 kaki.
Dialogue: 1,0:00:03.14,0:00:06.62,Sub,,0,0,0,,Sudah ada rumah contoh, porch depan memang besar.
Dialogue: 1,0:00:06.71,0:00:09.29,Sub,,0,0,0,,Build-up rumah 29 kaki,
Dialogue: 1,0:00:09.86,0:00:14.14,Sub,,0,0,0,,panjangnya 32 kaki.
Dialogue: 1,0:00:14.24,0:00:17.00,Sub,,0,0,0,,Ini showroom dia.
Dialogue: 1,0:00:17.00,0:00:18.52,Sub,,0,0,0,,Memang cantik!
Dialogue: 1,0:00:18.71,0:00:21.86,Sub,,0,0,0,,Bawah ada satu bilik dan stor.
Dialogue: 1,0:00:21.95,0:00:23.38,Sub,,0,0,0,,Bilik air.
Dialogue: 1,0:00:23.48,0:00:25.00,Sub,,0,0,0,,Tandas.
Dialogue: 1,0:00:25.10,0:00:26.90,Sub,,0,0,0,,Ini kitchen dia.
Dialogue: 1,0:00:27.00,0:00:29.67,Sub,,0,0,0,,Ini rumah semi-D.
Dialogue: 1,0:00:29.95,0:00:33.67,Sub,,0,0,0,,Belakang rumah ada tanah, tepi pun ada tanah.
Dialogue: 1,0:00:33.67,0:00:35.19,Sub,,0,0,0,,Belakang 10 kaki.
Dialogue: 1,0:00:35.19,0:00:37.76,Sub,,0,0,0,,Tepi pula ada 10 kaki tanah.
Dialogue: 1,0:00:37.86,0:00:40.81,Sub,,0,0,0,,Lantai SPC disediakan.
Dialogue: 1,0:00:40.90,0:00:43.95,Sub,,0,0,0,,Atas ada satu family hall.
Dialogue: 1,0:00:44.05,0:00:46.33,Sub,,0,0,0,,Bilik kedua, tandas sendiri.
Dialogue: 1,0:00:46.43,0:00:48.33,Sub,,0,0,0,,Bilik ketiga pun ada tandas sendiri.
Dialogue: 1,0:00:48.33,0:00:51.48,Sub,,0,0,0,,Jadi rumah ini 4 bilik, 4 tandas,
Dialogue: 1,0:00:51.48,0:00:54.62,Sub,,0,0,0,,double storey semi-D.
Dialogue: 1,0:00:54.71,0:00:56.67,Sub,,0,0,0,,Okey, master room.
